<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="PuppeteerSharp" Version="25.14.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <None Update="Fixtures/*.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Fixtures/*.pdf" CopyToOutputDirectory="PreserveNewest" />
    <Compile Include="../../src/Einsatzcockpit.PrintAgent/Pairing/PairingClient.cs" Link="PairingClient.cs" />
    <Compile Include="../../src/Einsatzcockpit.PrintAgent/Security/ITokenStore.cs" Link="ITokenStore.cs" />
    <Compile Include="../../src/Einsatzcockpit.PrintAgent/Fetching/HttpArtifactFetcher.cs" Link="HttpArtifactFetcher.cs" />
    <Compile Include="../../src/Einsatzcockpit.PrintAgent/Rendering/EdgeHtmlRenderer.cs" Link="EdgeHtmlRenderer.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Einsatzcockpit.PrintAgent.Core\Einsatzcockpit.PrintAgent.Core.csproj" />
  </ItemGroup>

</Project>
